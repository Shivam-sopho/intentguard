# --- Airwallex sandbox (optional: without these the app runs on the labelled offline emulator)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.sandbox.airwallex.com
# Reuse an existing READY cardholder instead of creating one per run (optional)
AIRWALLEX_CARDHOLDER_ID=

# --- Model backend for the probabilistic layer (auto-detected in this order):
#   1. ANTHROPIC_API_KEY set           -> Anthropic API (CLAUDE_MODEL)
#   2. `claude` CLI on PATH, logged in -> Claude Code headless (`claude -p`), no API key needed
#   3. neither                         -> labelled offline templates
# Force one with INTENTGUARD_LLM=api|claude-code|offline
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Optional model for the Claude Code backend (defaults to your Claude Code setting)
CLAUDE_CODE_MODEL=

# --- Server
PORT=8787
