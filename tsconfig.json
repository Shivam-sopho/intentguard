{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": [
    "packages/deterministic-engine/src",
    "packages/deterministic-engine/test",
    "packages/cognitive-agent/src",
    "packages/cognitive-agent/test",
    "packages/simulation-adapter/src",
    "packages/server/src"
  ]
}
